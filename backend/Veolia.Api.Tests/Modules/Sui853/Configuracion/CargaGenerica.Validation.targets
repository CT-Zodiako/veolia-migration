<Project>
  <!-- Opt-in focused compilation while unrelated legacy smoke-test doubles are out of sync. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Veolia.Api.Tests'">
    <Compile Remove="$(MSBuildProjectDirectory)/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)CargaGenericaTests.cs" />
  </ItemGroup>
</Project>
